dnf_statement = { Disjunction }

Disjunction = { Conjunction ~ (OR ~ Conjunction)* }
Conjunction = { Pred ~ (AND ~ Pred)* }
Pred        = { "(" ~ Term ~ Operator ~ Term ~ ")" }

Term        = _{ Number | Bool | Str | Ident }
Operator    = { "<=" | ">=" | "==" | "!=" | "<" | ">" }

OR          = _{ "OR" }
AND         = _{ "AND" }


